# Aegis runtime
AEGIS_DATABASE_PATH=var/aegis.db
AEGIS_CONTEXT_DATABASE_PATH=var/aegis-context.db
AEGIS_DATA_MODE=seeded
AEGIS_PRIME_BLOCKED=true
AEGIS_ALLOWED_ORIGIN=http://localhost:5173

# Optional live DataHub connection. In seeded mode these are not required.
DATAHUB_GMS_URL=http://host.docker.internal:8080
DATAHUB_GMS_TOKEN=
DATAHUB_GRAPHQL_URL=http://host.docker.internal:8080/api/graphql
DATAHUB_FRONTEND_URL=http://localhost:9002
DATAHUB_MCP_URL=http://datahub-mcp:8000/mcp
BUSINESS_MCP_URL=http://business-mcp:8010/mcp

# Required for live agent execution. Fixture mode never calls the model.
OPENAI_API_KEY=
AEGIS_OPENAI_MODEL=gpt-5.6-terra
AEGIS_OPENAI_REASONING_EFFORT=low

# Use strong random values outside local development; both services must match.
AEGIS_CAPABILITY_SIGNING_SECRET=dev-only-change-me
AEGIS_DATAHUB_ACTIONS_SHARED_SECRET=dev-actions-change-me

# DataHub quickstart Kafka endpoints used by the optional Actions profile.
DATAHUB_DOCKER_NETWORK=datahub_network
KAFKA_BOOTSTRAP_SERVER=broker:29092
SCHEMA_REGISTRY_URL=http://datahub-gms:8080/schema-registry/api/
